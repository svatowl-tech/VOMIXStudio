{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VOMIXStudio",
  "version": "1.0.0",
  "identifier": "com.vomixstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VOMIXStudio — C++ WASM Native Workstation",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: asset: http://localhost:3000; connect-src 'self' blob: data: http: https:; img-src 'self' blob: data: asset:; media-src 'self' blob: data: asset: stream:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "appimage", "deb", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Standalone C++ WebAssembly Audio Workstation & Video Dubbing Studio",
    "longDescription": "High-performance Desktop Audio Workstation powered by C++ WASM SIMD, React 19, and Native Windows WebView2.",
    "resources": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
